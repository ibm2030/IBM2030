# Logs and journals from any tool
*.log
*.jou

# Editor backups
*~

# --- Vivado ---------------------------------------------------------------
# Generated output; regenerated from the .xpr, .bd and .xci sources
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
.Xil/
# IP output products that older Vivado versions wrote next to the .xci
/IBM2030.srcs/**/ip/*/*.xml
# WebTalk usage reports
/webtalk_pn.xml
/usage_statistics_webtalk.html

# --- Vitis (workspace = repo root) -----------------------------------------
# Keep vitis-comp.json, CMake files and sources; ignore state and build output
/_ide/
/.rigel_lopper/
/ibm2030/*
!/ibm2030/vitis-comp.json
!/ibm2030/.gitignore
/zybo2030/build/
/zybo2030/_ide/
/zybo2030/peta2030/
/zybo2030/compile_commands.json
/zybo2030/*.[bB][iI][nN]

# --- ISE (legacy Spartan-3 flow: IBM2030.xise, digilentSP3.ucf) -------------
*.tmp/
_ngo/
_xmsgs/
iseconfig/
xst/
xlnx_auto*
import_ise_summary.txt
*.bgn
*.bld
*.cmd_log
*.drc
*.gise
*.lso
*.ncd
*.ngc
*.ngd
*.ngr
*.pad
*.par
*.pcf
